package = io.ktor.io.interop.liburing
headers = liburing.h
headerFilter = liburing/*
staticLibraries.linux = liburing.a
---
#include <errno.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

struct ktor_io_uring_ring {
    struct io_uring ring;
    char **open_paths;
    unsigned entries;
};

intptr_t ktor_io_uring_create(unsigned entries) {
    struct ktor_io_uring_ring *handle = calloc(1, sizeof(*handle));
    if (handle == NULL) return -ENOMEM;

    handle->open_paths = calloc(entries, sizeof(*handle->open_paths));
    if (handle->open_paths == NULL) {
        free(handle);
        return -ENOMEM;
    }

    int result = io_uring_queue_init(entries, &handle->ring, 0);
    if (result < 0) {
        free(handle->open_paths);
        free(handle);
        return result;
    }

    handle->entries = entries;
    return (intptr_t) handle;
}

void ktor_io_uring_destroy(uintptr_t value) {
    struct ktor_io_uring_ring *handle = (struct ktor_io_uring_ring *) value;
    if (handle == NULL) return;

    io_uring_queue_exit(&handle->ring);
    for (unsigned index = 0; index < handle->entries; index++) free(handle->open_paths[index]);
    free(handle->open_paths);
    free(handle);
}

static int ktor_io_uring_submit(struct ktor_io_uring_ring *handle) {
    int result = io_uring_submit(&handle->ring);
    return result < 0 ? result : 0;
}

int ktor_io_uring_submit_open(uintptr_t value, const char *path, int slot) {
    struct ktor_io_uring_ring *handle = (struct ktor_io_uring_ring *) value;
    if (slot < 0 || (unsigned) slot >= handle->entries) return -EINVAL;

    char *path_copy = strdup(path);
    if (path_copy == NULL) return -ENOMEM;

    struct io_uring_sqe *sqe = io_uring_get_sqe(&handle->ring);
    if (sqe == NULL) {
        free(path_copy);
        return -EAGAIN;
    }

    free(handle->open_paths[slot]);
    handle->open_paths[slot] = path_copy;
    io_uring_prep_openat(sqe, AT_FDCWD, path_copy, O_RDONLY | O_CLOEXEC, 0);
    io_uring_sqe_set_data64(sqe, (uint64_t) slot);
    int result = ktor_io_uring_submit(handle);
    if (result < 0) {
        handle->open_paths[slot] = NULL;
        free(path_copy);
    }
    return result;
}

int ktor_io_uring_submit_read(uintptr_t value, int fd, uintptr_t address, int length, uint64_t offset, int slot) {
    struct ktor_io_uring_ring *handle = (struct ktor_io_uring_ring *) value;
    struct io_uring_sqe *sqe = io_uring_get_sqe(&handle->ring);
    if (sqe == NULL) return -EAGAIN;

    io_uring_prep_read(sqe, fd, (void *) address, (unsigned) length, offset);
    io_uring_sqe_set_data64(sqe, (uint64_t) slot);
    return ktor_io_uring_submit(handle);
}

int ktor_io_uring_submit_close(uintptr_t value, int fd, int slot) {
    struct ktor_io_uring_ring *handle = (struct ktor_io_uring_ring *) value;
    struct io_uring_sqe *sqe = io_uring_get_sqe(&handle->ring);
    if (sqe == NULL) return -EAGAIN;

    io_uring_prep_close(sqe, fd);
    io_uring_sqe_set_data64(sqe, (uint64_t) slot);
    return ktor_io_uring_submit(handle);
}

int ktor_io_uring_submit_cancel(uintptr_t value, int slot) {
    struct ktor_io_uring_ring *handle = (struct ktor_io_uring_ring *) value;
    struct io_uring_sqe *sqe = io_uring_get_sqe(&handle->ring);
    if (sqe == NULL) return -EAGAIN;

    io_uring_prep_cancel64(sqe, (uint64_t) slot, 0);
    io_uring_sqe_set_data64(sqe, UINT64_MAX);
    return ktor_io_uring_submit(handle);
}

int ktor_io_uring_submit_wake(uintptr_t value) {
    struct ktor_io_uring_ring *handle = (struct ktor_io_uring_ring *) value;
    struct io_uring_sqe *sqe = io_uring_get_sqe(&handle->ring);
    if (sqe == NULL) return -EAGAIN;

    io_uring_prep_nop(sqe);
    io_uring_sqe_set_data64(sqe, UINT64_MAX - 1);
    return ktor_io_uring_submit(handle);
}

int ktor_io_uring_wait(uintptr_t value, int *slot, int *result) {
    struct ktor_io_uring_ring *handle = (struct ktor_io_uring_ring *) value;
    struct io_uring_cqe *cqe = NULL;
    int wait_result = io_uring_wait_cqe(&handle->ring, &cqe);
    if (wait_result < 0) return wait_result;

    uint64_t user_data = io_uring_cqe_get_data64(cqe);
    *slot = (int32_t) (uint32_t) user_data;
    *result = cqe->res;
    if (user_data < handle->entries) {
        free(handle->open_paths[user_data]);
        handle->open_paths[user_data] = NULL;
    }
    io_uring_cqe_seen(&handle->ring, cqe);
    return 0;
}